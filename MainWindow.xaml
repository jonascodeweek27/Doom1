

    <Window x:Class="DoomWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOOM WPF"
        Width="1000" Height="650"
        MinWidth="800" MinHeight="500"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        MouseMove="Window_MouseMove"
        Loaded="Window_Loaded"
        Focusable="True">

            <Grid Background="Black">
                <Image x:Name="GameImage"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="18">
                    <TextBlock Text="DOOM WPF"
                       Foreground="Red"
                       FontSize="26"
                       FontWeight="Bold"/>
                    <TextBlock x:Name="HealthText"
                       Foreground="White"
                       FontSize="18"/>
                    <TextBlock x:Name="EnemyText"
                       Foreground="White"
                       FontSize="16"/>
                </StackPanel>

                <TextBlock Text="+"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                <Border x:Name="Overlay"
                Background="#E0000000"
                Visibility="Visible">
                    <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                        <TextBlock Text="DOOM"
                           Foreground="Red"
                           FontSize="56"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                        <TextBlock Text="WASD = Bewegen | Maus = Umsehen"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,20,0,8"
                           HorizontalAlignment="Center"/>
                        <TextBlock Text="Linksklick = Schießen"
                           Foreground="White"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                        <Button Content="SPIEL STARTEN"
                        Click="Start_Click"
                        Width="200"
                        Height="48"
                        FontSize="18"
                        Margin="0,25,0,0"
                        Background="DarkRed"
                        Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Window>

   
